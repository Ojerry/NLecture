{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],

    /* Strictness — the whole point of the lessons */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Interop & output */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",

    /* Allow .js files to live alongside .ts without breaking the build */
    "allowJs": true,
    "checkJs": false
  },
  "include": ["L1/**/*", "**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
